<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Foodbook.Views.Components.UniversalSpinnerComponent"
             x:Name="SpinnerRoot">
    <Grid IsVisible="{Binding SpinnerVisible, Source={x:Reference SpinnerRoot}}"
          BackgroundColor="#80000000"
          ZIndex="10">
        <Border HorizontalOptions="Center"
                VerticalOptions="Center"
                StrokeThickness="0"
                BackgroundColor="{DynamicResource FrameBackgroundColor}"
                StrokeShape="RoundRectangle 16"
                Padding="20"
                WidthRequest="260">
            <VerticalStackLayout Spacing="8">
                <ActivityIndicator IsRunning="{Binding SpinnerVisible, Source={x:Reference SpinnerRoot}}"
                                   Color="{DynamicResource Primary}"
                                   WidthRequest="36"
                                   HeightRequest="36" />
                <Label Text="{Binding LoadingStatus, Source={x:Reference SpinnerRoot}}"
                       FontSize="14"
                       FontAttributes="Bold"
                       TextColor="{DynamicResource FrameTextColor}"
                       HorizontalTextAlignment="Center" />
                <ProgressBar Progress="{Binding LoadingProgress, Source={x:Reference SpinnerRoot}}"
                             ProgressColor="{DynamicResource Primary}"
                             BackgroundColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}"
                             HeightRequest="6"
                             IsVisible="{Binding ShowProgress, Source={x:Reference SpinnerRoot}}" />
                <Label FontSize="12"
                       HorizontalTextAlignment="Center"
                       TextColor="{DynamicResource Gray500}"
                       IsVisible="{Binding ShowProgress, Source={x:Reference SpinnerRoot}}">
                    <Label.Text>
                        <MultiBinding StringFormat="{}{0:P0}">
                            <Binding Path="LoadingProgress" Source="{x:Reference SpinnerRoot}" />
                        </MultiBinding>
                    </Label.Text>
                </Label>
                <Label Text="{Binding TipText, Source={x:Reference SpinnerRoot}}"
                       FontSize="12"
                       TextColor="{DynamicResource Gray500}"
                       HorizontalTextAlignment="Center"
                       IsVisible="{Binding ShowTip, Source={x:Reference SpinnerRoot}}" />
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentView>
